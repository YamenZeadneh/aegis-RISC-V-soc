(header "symbol" (version "1.2"))
(symbol
	(rect 128 48 240 160)
	(text "shift_1" (rect 16 16 50 26)(font "Arial" ))
	(text "inst" (rect 8 96 25 106)(font "Arial" ))
	(port
		(pt 40 112)
		(input)
		(text "X[63..0]" (rect -64 32 -27 42)(font "Arial" ))
		(text "X[63..0]" (rect 32 49 42 86)(font "Arial" )(vertical))
		(line (pt 40 112)(pt 40 96)(line_width 3))
	)
	(port
		(pt 112 48)
		(output)
		(text "Y[63..0]" (rect -48 16 -8 26)(font "Arial" ))
		(text "Y[63..0]" (rect 58 43 91 53)(font "Arial" ))
		(line (pt 112 48)(pt 96 48)(line_width 3))
	)
	(drawing
		(rectangle (rect 24 40 96 88))
	)
)
